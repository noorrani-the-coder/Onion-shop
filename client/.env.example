# Backend base URL used by the Android build (Capacitor has no dev proxy).
# Leave empty for `npm run dev` / web builds so requests stay relative.
# Examples:
#   VITE_API_BASE_URL=http://192.168.1.5:5000     # server on your LAN
#   VITE_API_BASE_URL=https://onion-api.example.com
VITE_API_BASE_URL=
