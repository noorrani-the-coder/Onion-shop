# Server Port
PORT=5000

# Ollama Cloud API Key (for AI market report parsing) - https://ollama.com/settings/keys
OLLAMA_API_KEY=
# Optional overrides
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b-cloud

# Supabase Database Configuration
# Copy your Project URL & Anon/Service Role Key from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=
